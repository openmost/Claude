{% extends 'admin.twig' %}

{% set title %}{{ 'Claude_SystemSettingsMenu'|translate }}{% endset %}

{% block content %}
    <div vue-entry="Claude.ManageSystemSettings"
         fields="{{ fields|json_encode|e('html_attr') }}"
         settings="{{ values|json_encode|e('html_attr') }}"
         ai-providers-notice="{{ aiProvidersNotice|json_encode|e('html_attr') }}"
         default-prompts="{{ defaultPrompts|json_encode|e('html_attr') }}"
    ></div>
{% endblock %}
